{% render 'timer-content', block: block, display_mode: 'section' %}

{% schema %}
{
  "name": "Countdown timer bar",
  "target": "section",
  "settings": [
    { "type": "paragraph", "content": "Place this timer inside a theme section. It uses the same saved countdown as the global app embed and takes priority when both are enabled." },
    { "type": "range", "id": "countdown_days", "label": "Countdown days", "min": 0, "max": 30, "step": 1, "unit": "day", "default": 0 },
    { "type": "range", "id": "countdown_hours", "label": "Countdown hours", "min": 0, "max": 23, "step": 1, "unit": "hr", "default": 0 },
    { "type": "range", "id": "countdown_minutes", "label": "Countdown minutes", "min": 0, "max": 59, "step": 1, "unit": "min", "default": 15 },
    { "type": "text", "id": "promo_text", "label": "Promo text string", "default": "HURRY! Flash Sale Ends In:" },
    { "type": "text", "id": "expired_text", "label": "Expired text string", "default": "Offer expired!" },
    {
      "type": "select",
      "id": "expiry_action",
      "label": "On expiry action",
      "default": "message",
      "options": [
        { "value": "hide", "label": "Hide bar" },
        { "value": "message", "label": "Show expiry message" }
      ]
    },
    { "type": "url", "id": "button_link", "label": "Button link URL" },
    { "type": "text", "id": "button_text", "label": "Button text label", "default": "Shop sale" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FFF3CD" },
    { "type": "color", "id": "font_color", "label": "Font text color", "default": "#202223" },
    { "type": "color", "id": "digit_accent", "label": "Timer digit accent", "default": "#D72C0D" }
  ]
}
{% endschema %}
