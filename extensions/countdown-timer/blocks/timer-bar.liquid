{% render 'timer-content', block: block %}

{% schema %}
{
  "name": "Sales countdown timer bar",
  "target": "body",
  "settings": [
    { "type": "paragraph", "content": "Privacy-first countdown campaigns. All timing runs in the shopper's browser with no external tracking or server." },
    {
      "type": "select",
      "id": "timer_mode",
      "label": "Timer mode",
      "default": "evergreen",
      "options": [
        { "value": "evergreen", "label": "Evergreen visitor timer" },
        { "value": "fixed", "label": "Fixed campaign deadline" },
        { "value": "daily", "label": "Daily recurring deadline" },
        { "value": "cart", "label": "Cart reservation timer" }
      ]
    },
    { "type": "range", "id": "countdown_days", "label": "Countdown days", "min": 0, "max": 30, "step": 1, "unit": "day", "default": 0 },
    { "type": "range", "id": "countdown_hours", "label": "Countdown hours", "min": 0, "max": 23, "step": 1, "unit": "hr", "default": 0 },
    { "type": "range", "id": "countdown_minutes", "label": "Countdown minutes", "min": 0, "max": 59, "step": 1, "unit": "min", "default": 15 },
    {
      "type": "select",
      "id": "clock_display",
      "label": "Clock display",
      "default": "auto",
      "info": "Use days only for long campaigns. Evergreen timers under 24 hours show HH:MM:SS.",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "hours", "label": "Hours, minutes, seconds" },
        { "value": "days", "label": "Days, hours, minutes, seconds" }
      ]
    },
    { "type": "text", "id": "fixed_end", "label": "Fixed deadline (ISO 8601)", "info": "Example: 2026-12-31T23:59:00-05:00", "default": "2026-12-31T23:59:00Z" },
    { "type": "range", "id": "daily_end_hour", "label": "Daily end hour", "min": 0, "max": 23, "step": 1, "default": 23 },
    { "type": "range", "id": "daily_end_minute", "label": "Daily end minute", "min": 0, "max": 59, "step": 1, "default": 59 },
    { "type": "number", "id": "reset_token", "label": "Restart timer number", "info": "Change this number and save to restart evergreen and cart timers for visitors.", "default": 1 },
    { "type": "text", "id": "promo_text", "label": "Promo text string", "default": "HURRY! Flash Sale Ends In:" },
    { "type": "text", "id": "expired_text", "label": "Expired text string", "default": "Offer expired!" },
    {
      "type": "select",
      "id": "page_visibility",
      "label": "Show on pages",
      "default": "all",
      "options": [
        { "value": "all", "label": "All pages" },
        { "value": "home", "label": "Home page only" },
        { "value": "product", "label": "Product pages only" },
        { "value": "collection", "label": "Collection pages only" },
        { "value": "cart", "label": "Cart page only" }
      ]
    },
    { "type": "header", "content": "Product and collection targeting" },
    { "type": "checkbox", "id": "catalog_targeting_enabled", "label": "Only show for matching catalog rules", "default": false },
    { "type": "textarea", "id": "include_product_handles", "label": "Include product handles", "info": "Comma-separated. Example: classic-shirt, leather-bag" },
    { "type": "textarea", "id": "include_vendors", "label": "Include product vendors", "info": "Comma-separated vendor names." },
    { "type": "textarea", "id": "include_product_types", "label": "Include product types", "info": "Comma-separated product types." },
    { "type": "textarea", "id": "include_product_tags", "label": "Include product tags", "info": "Comma-separated tags. Any matching tag displays the timer." },
    { "type": "textarea", "id": "include_collections", "label": "Include collection handles", "info": "Comma-separated. Works on collection pages and products inside those collections." },
    { "type": "textarea", "id": "exclude_product_handles", "label": "Exclude product handles", "info": "Excluded products always remain hidden." },
    { "type": "textarea", "id": "exclude_vendors", "label": "Exclude product vendors", "info": "Excluded vendors always remain hidden." },
    {
      "type": "select",
      "id": "device_visibility",
      "label": "Device visibility",
      "default": "all",
      "options": [
        { "value": "all", "label": "Desktop and mobile" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "mobile", "label": "Mobile only" }
      ]
    },
    {
      "type": "select",
      "id": "positioning",
      "label": "Positioning",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "design_preset",
      "label": "Design preset",
      "default": "solid",
      "options": [
        { "value": "minimal", "label": "Minimal" },
        { "value": "solid", "label": "Solid" },
        { "value": "urgent", "label": "Animated urgency" }
      ]
    },
    {
      "type": "select",
      "id": "expiry_action",
      "label": "On expiry action",
      "default": "message",
      "options": [
        { "value": "hide", "label": "Hide bar" },
        { "value": "message", "label": "Show expiry message" }
      ]
    },
    { "type": "url", "id": "button_link", "label": "Button link URL" },
    { "type": "text", "id": "button_text", "label": "Button text label", "default": "Shop sale" },
    { "type": "checkbox", "id": "dismissible", "label": "Allow shoppers to dismiss bar", "default": false },
    { "type": "checkbox", "id": "show_labels", "label": "Show time unit labels", "default": false },
    { "type": "text", "id": "days_label", "label": "Days label", "default": "Days" },
    { "type": "text", "id": "hours_label", "label": "Hours label", "default": "Hours" },
    { "type": "text", "id": "minutes_label", "label": "Minutes label", "default": "Mins" },
    { "type": "text", "id": "seconds_label", "label": "Seconds label", "default": "Secs" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#050505" },
    { "type": "color", "id": "font_color", "label": "Font text color", "default": "#FFFFFF" },
    { "type": "color", "id": "digit_accent", "label": "Timer digit accent", "default": "#FFFFFF" }
  ]
}
{% endschema %}
