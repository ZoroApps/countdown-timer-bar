{% liquid
  assign timer_id = 'zoro-standalone-timer-' | append: block.id
  assign position_class = 'zoro-timer--' | append: block.settings.positioning
%}
<div id="{{ timer_id }}" class="zoro-timer {{ position_class }}" role="region" aria-label="Sales countdown timer" {{ block.shopify_attributes }}>
  <div class="zoro-timer__layout"><p class="zoro-timer__promo" data-zoro-promo>{{ block.settings.promo_text }}</p><div class="zoro-timer__clock" data-zoro-clock role="timer" aria-label="Time remaining"><span class="zoro-timer__digit"><strong data-zoro-hours>00</strong></span><span class="zoro-timer__separator">:</span><span class="zoro-timer__digit"><strong data-zoro-minutes>00</strong></span><span class="zoro-timer__separator">:</span><span class="zoro-timer__digit"><strong data-zoro-seconds>00</strong></span></div>{% if block.settings.button_text != blank %}<a class="zoro-timer__button" data-zoro-button href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_text }}</a>{% endif %}</div>
</div>
<style>
#{{ timer_id }}{--bg:{{ block.settings.background_color }};--text:{{ block.settings.font_color }};--accent:{{ block.settings.digit_accent }};position:fixed;left:0;right:0;z-index:2147483647;width:100%;padding:3px 12px;color:var(--text);background:var(--bg);box-shadow:0 1px 4px #0000001f;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;transition:opacity .26s,visibility .26s,transform .26s}#{{ timer_id }} *{box-sizing:border-box}#{{ timer_id }}.zoro-timer--top{top:0}#{{ timer_id }}.zoro-timer--bottom{bottom:0}#{{ timer_id }}.zoro-timer--hidden{visibility:hidden;opacity:0;pointer-events:none}#{{ timer_id }} .zoro-timer__layout{display:flex;align-items:center;justify-content:center;gap:8px;max-width:1200px;margin:auto}#{{ timer_id }} .zoro-timer__promo{margin:0;overflow:hidden;font-size:clamp(.68rem,1vw,.78rem);font-weight:650;line-height:1;text-overflow:ellipsis;white-space:nowrap}#{{ timer_id }} .zoro-timer__clock{display:flex;align-items:center;gap:2px;flex-shrink:0}#{{ timer_id }} .zoro-timer__digit{display:grid;min-width:28px;min-height:24px;place-content:center;padding:2px 4px;color:#fff;background:var(--accent);border-radius:4px;font-size:.78rem;font-variant-numeric:tabular-nums}#{{ timer_id }} .zoro-timer__separator{font-size:.7rem;font-weight:700}#{{ timer_id }} .zoro-timer__button{min-height:24px;padding:3px 8px;color:#fff;background:var(--accent);border-radius:4px;font-size:.66rem;font-weight:650;text-decoration:none;white-space:nowrap}#{{ timer_id }} .zoro-timer__button[aria-disabled=true]{opacity:.5;pointer-events:none}@media(max-width:749px){#{{ timer_id }}{padding:3px 6px}#{{ timer_id }} .zoro-timer__layout{gap:4px}#{{ timer_id }} .zoro-timer__promo{flex:1;font-size:.64rem}#{{ timer_id }} .zoro-timer__digit{min-width:25px;min-height:22px;font-size:.68rem}}@media(max-width:480px){#{{ timer_id }} .zoro-timer__button{display:none}}
</style>
<script>
(()=>{const el=document.getElementById({{ timer_id | json }});if(!el||el.dataset.ready)return;el.dataset.ready='1';const key='zoro_timer_session_by_duration',minutes=Math.max(1,Math.min(15,Number({{ block.settings.countdown_minutes | json }})||15)),duration=minutes*60000,action={{ block.settings.expiry_action | json }},expiredText={{ block.settings.expired_text | json }},promo=el.querySelector('[data-zoro-promo]'),clock=el.querySelector('[data-zoro-clock]'),button=el.querySelector('[data-zoro-button]'),h=el.querySelector('[data-zoro-hours]'),m=el.querySelector('[data-zoro-minutes]'),s=el.querySelector('[data-zoro-seconds]');let expired=false,timer=null,session=read(),matches=session&&session.minutes===minutes,end=matches?session.end:null;function read(){try{const v=JSON.parse(localStorage.getItem(key));return v&&Number.isFinite(Number(v.end))?{end:Number(v.end),minutes:Number(v.minutes)}:null}catch(_){return null}}function write(v){try{localStorage.setItem(key,JSON.stringify({end:v,minutes}))}catch(_){}}if(!end){end=Date.now()+duration;write(end)}const pad=v=>String(v).padStart(2,'0');function expire(){if(expired)return;expired=true;if(timer)clearInterval(timer);h.textContent=m.textContent=s.textContent='00';if(button){button.removeAttribute('href');button.setAttribute('aria-disabled','true');button.tabIndex=-1}if(action==='hide')el.classList.add('zoro-timer--hidden');else{promo.textContent=expiredText;promo.setAttribute('role','alert');clock.hidden=true}}function render(){const left=Math.max(0,end-Date.now()),total=Math.ceil(left/1000);h.textContent=pad(Math.floor(total/3600));m.textContent=pad(Math.floor(total%3600/60));s.textContent=pad(total%60);if(left<=0)expire()}render();if(!expired)timer=setInterval(()=>{if(!el.isConnected){location.reload();return}render()},250);addEventListener('storage',e=>{if(e.key!==key)return;const v=read();if(v){end=v.end;render()}})})();
</script>
{% schema %}
{"name":"Sales countdown timer bar","target":"body","settings":[{"type":"range","id":"countdown_minutes","label":"Countdown length in minutes","min":1,"max":15,"step":1,"unit":"min","default":15},{"type":"text","id":"promo_text","label":"Promo text string","default":"HURRY! Flash Sale Ends In:"},{"type":"text","id":"expired_text","label":"Expired text string","default":"Offer expired!"},{"type":"select","id":"positioning","label":"Positioning","default":"top","options":[{"value":"top","label":"Top"},{"value":"bottom","label":"Bottom"}]},{"type":"select","id":"expiry_action","label":"On Expiry Action","default":"message","options":[{"value":"hide","label":"Hide Bar"},{"value":"message","label":"Show Expiry Message"}]},{"type":"url","id":"button_link","label":"Button link URL"},{"type":"text","id":"button_text","label":"Button text label","default":"Shop sale"},{"type":"color","id":"background_color","label":"Background color","default":"#FFF3CD"},{"type":"color","id":"font_color","label":"Font text color","default":"#202223"},{"type":"color","id":"digit_accent","label":"Timer digit accent","default":"#D72C0D"}]}
{% endschema %}
