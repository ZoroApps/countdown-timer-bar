{% liquid
  assign timer_id = 'zoro-standalone-timer-' | append: block.id
  assign position_class = 'zoro-timer--' | append: block.settings.positioning
%}

<div id="{{ timer_id }}" class="zoro-timer {{ position_class }}" role="region" aria-label="Sales countdown timer" {{ block.shopify_attributes }}>
  <div class="zoro-timer__layout">
    <p class="zoro-timer__promo" data-zoro-promo>{{ block.settings.promo_text }}</p>
    <div class="zoro-timer__clock" data-zoro-clock role="timer" aria-label="Time remaining">
      <span class="zoro-timer__digit"><strong data-zoro-hours>00</strong></span><span class="zoro-timer__separator" aria-hidden="true">:</span><span class="zoro-timer__digit"><strong data-zoro-minutes>00</strong></span><span class="zoro-timer__separator" aria-hidden="true">:</span><span class="zoro-timer__digit"><strong data-zoro-seconds>00</strong></span>
    </div>
    {% if block.settings.button_text != blank %}<a class="zoro-timer__button" data-zoro-button href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_text }}</a>{% endif %}
  </div>
</div>

<style>
  #{{ timer_id }} {
    --zoro-bg: {{ block.settings.background_color }}; --zoro-text: {{ block.settings.font_color }}; --zoro-accent: {{ block.settings.digit_accent }};
    position: fixed; right: 0; left: 0; z-index: 2147483647; box-sizing: border-box; width: 100%; padding: 3px 12px;
    color: var(--zoro-text); background: var(--zoro-bg); box-shadow: 0 1px 4px rgba(0,0,0,.12);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    transition: opacity 260ms ease, visibility 260ms ease, transform 260ms ease;
  }
  #{{ timer_id }} *, #{{ timer_id }} *::before, #{{ timer_id }} *::after { box-sizing: border-box; }
  #{{ timer_id }}.zoro-timer--top { top: 0; } #{{ timer_id }}.zoro-timer--bottom { bottom: 0; }
  #{{ timer_id }}.zoro-timer--hidden { visibility: hidden; opacity: 0; pointer-events: none; }
  #{{ timer_id }}.zoro-timer--top.zoro-timer--hidden { transform: translateY(-100%); }
  #{{ timer_id }}.zoro-timer--bottom.zoro-timer--hidden { transform: translateY(100%); }
  #{{ timer_id }} .zoro-timer__layout { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; max-width: 1200px; margin: 0 auto; }
  #{{ timer_id }} .zoro-timer__promo { margin: 0; overflow: hidden; font-size: clamp(.68rem,1vw,.78rem); font-weight: 650; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }
  #{{ timer_id }} .zoro-timer__clock { display: flex; flex-shrink: 0; align-items: center; gap: 2px; }
  #{{ timer_id }} .zoro-timer__digit { display: grid; min-width: 28px; min-height: 24px; place-content: center; padding: 2px 4px; color: #fff; background: var(--zoro-accent); border: 1px solid rgba(0,0,0,.16); border-radius: 4px; box-shadow: inset 0 -1px 0 rgba(0,0,0,.16); text-align: center; }
  #{{ timer_id }} .zoro-timer__digit strong { font-size: clamp(.72rem,1.2vw,.82rem); font-variant-numeric: tabular-nums; line-height: 1; }
  #{{ timer_id }} .zoro-timer__separator { font-size: .7rem; font-weight: 700; }
  #{{ timer_id }} .zoro-timer__button { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; min-height: 24px; padding: 2px 8px; color: #fff; background: var(--zoro-accent); border: 1px solid rgba(0,0,0,.16); border-radius: 4px; font-size: .66rem; font-weight: 650; text-decoration: none; white-space: nowrap; }
  #{{ timer_id }} .zoro-timer__button:hover { filter: brightness(.92); } #{{ timer_id }} .zoro-timer__button[aria-disabled='true'] { opacity: .5; pointer-events: none; }
  @media screen and (max-width: 749px) {
    #{{ timer_id }} { padding: 3px 6px; } #{{ timer_id }} .zoro-timer__layout { gap: 4px; }
    #{{ timer_id }} .zoro-timer__promo { flex: 1 1 auto; font-size: clamp(.58rem,2.4vw,.68rem); }
    #{{ timer_id }} .zoro-timer__digit { min-width: 25px; min-height: 22px; padding: 1px 3px; }
    #{{ timer_id }} .zoro-timer__digit strong { font-size: .68rem; } #{{ timer_id }} .zoro-timer__separator { font-size: .62rem; }
    #{{ timer_id }} .zoro-timer__button { min-height: 22px; padding: 2px 5px; font-size: .58rem; }
  }
  @media screen and (max-width: 480px) { #{{ timer_id }} .zoro-timer__button { display: none; } }
  @media (prefers-reduced-motion: reduce) { #{{ timer_id }}, #{{ timer_id }} .zoro-timer__button { transition: none; } }
</style>

<script>
  (() => {
    const container = document.getElementById({{ timer_id | json }}); if (!container || container.dataset.zoroInitialized === 'true') return; container.dataset.zoroInitialized = 'true';
    const storageKey = 'zoro_timer_session'; const durationMinutes = Math.max(1, Number({{ block.settings.countdown_minutes | json }}) || 15); const expiryAction = {{ block.settings.expiry_action | json }}; const expiredText = {{ block.settings.expired_text | json }};
    const promo = container.querySelector('[data-zoro-promo]'); const clock = container.querySelector('[data-zoro-clock]'); const button = container.querySelector('[data-zoro-button]'); const hours = container.querySelector('[data-zoro-hours]'); const minutes = container.querySelector('[data-zoro-minutes]'); const seconds = container.querySelector('[data-zoro-seconds]'); let intervalId = null; let expired = false;
    const readEndTime = () => { try { const value = Number(localStorage.getItem(storageKey)); return Number.isFinite(value) && value > 0 ? value : null; } catch (_) { return null; } };
    const writeEndTime = value => { try { localStorage.setItem(storageKey, String(value)); } catch (_) {} };
    let endTime = readEndTime(); if (endTime === null) { endTime = Date.now() + durationMinutes * 60000; writeEndTime(endTime); }
    const pad = value => String(value).padStart(2, '0');
    const expire = () => { if (expired) return; expired = true; if (intervalId !== null) clearInterval(intervalId); hours.textContent = minutes.textContent = seconds.textContent = '00'; if (button) { button.removeAttribute('href'); button.setAttribute('aria-disabled','true'); button.setAttribute('tabindex','-1'); } if (expiryAction === 'hide') container.classList.add('zoro-timer--hidden'); else { promo.textContent = expiredText; promo.setAttribute('role','alert'); clock.hidden = true; } };
    const render = () => { const remainingMs = Math.max(0, endTime - Date.now()); const totalSeconds = Math.ceil(remainingMs / 1000); hours.textContent = pad(Math.floor(totalSeconds / 3600)); minutes.textContent = pad(Math.floor((totalSeconds % 3600) / 60)); seconds.textContent = pad(totalSeconds % 60); if (remainingMs <= 0) expire(); };
    render(); if (!expired) intervalId = setInterval(render, 250);
    addEventListener('storage', event => { if (event.key !== storageKey) return; const synced = Number(event.newValue); if (Number.isFinite(synced) && synced > 0) { endTime = synced; render(); } });
  })();
</script>

{% schema %}
{"name":"Sales countdown timer bar","target":"body","settings":[{"type":"number","id":"countdown_minutes","label":"Countdown length in minutes","default":15},{"type":"text","id":"promo_text","label":"Promo text string","default":"HURRY! Flash Sale Ends In:"},{"type":"text","id":"expired_text","label":"Expired text string","default":"Offer expired!"},{"type":"select","id":"positioning","label":"Positioning","default":"top","options":[{"value":"top","label":"Top"},{"value":"bottom","label":"Bottom"}]},{"type":"select","id":"expiry_action","label":"On Expiry Action","default":"message","options":[{"value":"hide","label":"Hide Bar"},{"value":"message","label":"Show Expiry Message"}]},{"type":"url","id":"button_link","label":"Button link URL"},{"type":"text","id":"button_text","label":"Button text label","default":"Shop sale"},{"type":"color","id":"background_color","label":"Background color","default":"#FFF3CD"},{"type":"color","id":"font_color","label":"Font text color","default":"#202223"},{"type":"color","id":"digit_accent","label":"Timer digit accent","default":"#D72C0D"}]}
{% endschema %}
