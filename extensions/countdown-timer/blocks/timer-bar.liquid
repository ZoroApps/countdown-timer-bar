{% liquid
  assign timer_id = 'zoro-timer-' | append: block.id
  assign position_class = 'zoro-timer--' | append: block.settings.positioning
%}
<div id="{{ timer_id }}" class="zoro-timer {{ position_class }}" role="region" aria-label="Sales countdown timer" {{ block.shopify_attributes }}>
  <div class="zoro-timer__layout"><p data-promo>{{ block.settings.promo_text }}</p><div class="zoro-timer__clock" data-clock role="timer"><b data-h>00</b><i>:</i><b data-m>00</b><i>:</i><b data-s>00</b></div><span data-fire hidden>🔥</span>{% if block.settings.button_text != blank %}<a data-button href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_text }}</a>{% endif %}</div>
</div>
<style>
#{{ timer_id }}{--bg:{{ block.settings.background_color }};--fg:{{ block.settings.font_color }};--accent:{{ block.settings.digit_accent }};position:fixed;left:0;right:0;z-index:2147483647;padding:3px 12px;color:var(--fg);background:var(--bg);box-shadow:0 1px 4px #0002;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;transition:.25s}#{{ timer_id }} *{box-sizing:border-box}#{{ timer_id }}.zoro-timer--top{top:0}#{{ timer_id }}.zoro-timer--bottom{bottom:0}#{{ timer_id }}.zoro-timer--hidden{visibility:hidden;opacity:0;pointer-events:none}#{{ timer_id }} .zoro-timer__layout{display:flex;align-items:center;justify-content:center;gap:8px;max-width:1200px;margin:auto}#{{ timer_id }} p{margin:0;overflow:hidden;font-size:clamp(.68rem,1vw,.78rem);font-weight:650;line-height:1;text-overflow:ellipsis;white-space:nowrap}#{{ timer_id }} .zoro-timer__clock{display:flex;align-items:center;gap:2px;flex-shrink:0}#{{ timer_id }} b{display:grid;min-width:28px;min-height:24px;place-content:center;padding:2px 4px;color:#fff;background:var(--accent);border-radius:4px;font-size:.78rem;font-variant-numeric:tabular-nums}#{{ timer_id }} i{font-style:normal;font-size:.7rem;font-weight:700}#{{ timer_id }} a{min-height:24px;padding:3px 8px;color:#fff;background:var(--accent);border-radius:4px;font-size:.66rem;font-weight:650;text-decoration:none;white-space:nowrap}#{{ timer_id }} a[aria-disabled=true]{opacity:.5;pointer-events:none}#{{ timer_id }}[data-high=true]{color:#fff;background:#b42318;animation:zoroWarn .7s ease-in-out infinite alternate}#{{ timer_id }}[data-high=true] b,#{{ timer_id }}[data-high=true] a{color:#7a271a;background:#fff}#{{ timer_id }}[data-high=true] .zoro-timer__clock{animation:zoroClock .5s ease-in-out infinite alternate}@keyframes zoroWarn{to{background:#e11900;box-shadow:0 1px 10px #e11900b3}}@keyframes zoroClock{to{transform:scale(1.04)}}@media(max-width:749px){#{{ timer_id }}{padding:3px 6px}#{{ timer_id }} .zoro-timer__layout{gap:4px}#{{ timer_id }} p{flex:1;font-size:.64rem}#{{ timer_id }} b{min-width:25px;min-height:22px;font-size:.68rem}}@media(max-width:480px){#{{ timer_id }} a{display:none}}@media(prefers-reduced-motion:reduce){#{{ timer_id }},#{{ timer_id }} .zoro-timer__clock{animation:none}}
</style>
<script>
(()=>{const el=document.getElementById({{ timer_id | json }});if(!el||el.dataset.ready)return;el.dataset.ready='1';const ver=String({{ block.settings.restart_number | json }}),baseKey='zoro_timer_session_'+ver,highKey='zoro_high_value_cart_session_'+ver,duration=Math.max(1,Number({{ block.settings.countdown_minutes | json }})||15)*60000,threshold=Math.max(0,Number({{ block.settings.high_value_threshold | json }})||0)*100,highText={{ block.settings.high_value_text | json }},expiredText={{ block.settings.expired_text | json }},action={{ block.settings.expiry_action | json }},promo=el.querySelector('[data-promo]'),clock=el.querySelector('[data-clock]'),fire=el.querySelector('[data-fire]'),button=el.querySelector('[data-button]'),h=el.querySelector('[data-h]'),m=el.querySelector('[data-m]'),s=el.querySelector('[data-s]'),normalText=promo.textContent,href=button?.getAttribute('href');let high=false,busy=false,baseEnd=read(baseKey),highEnd=null;if(!baseEnd){baseEnd=Date.now()+duration;write(baseKey,baseEnd)}function read(k){try{const v=Number(localStorage.getItem(k));return Number.isFinite(v)&&v>0?v:null}catch(_){return null}}function write(k,v){try{localStorage.setItem(k,String(v))}catch(_){}}function remove(k){try{localStorage.removeItem(k)}catch(_){}}function pad(v){return String(v).padStart(2,'0')}function enable(){if(button&&href){button.href=href;button.removeAttribute('aria-disabled');button.removeAttribute('tabindex')}}function expire(msg){h.textContent=m.textContent=s.textContent='00';if(button){button.removeAttribute('href');button.setAttribute('aria-disabled','true');button.tabIndex=-1}if(action==='hide')el.classList.add('zoro-timer--hidden');else{promo.textContent=msg;promo.setAttribute('role','alert');clock.hidden=true;fire.hidden=true}}function render(){const end=high?highEnd:baseEnd,left=Math.max(0,end-Date.now()),total=Math.ceil(left/1000);h.textContent=pad(Math.floor(total/3600));m.textContent=pad(Math.floor(total%3600/60));s.textContent=pad(total%60);if(left<=0)expire(high?'Your high-value cart reservation has expired! 🔥':expiredText)}function activate(){if(!high){high=true;highEnd=read(highKey);if(!highEnd){highEnd=Date.now()+300000;write(highKey,highEnd)}}el.classList.remove('zoro-timer--hidden');el.dataset.high='true';promo.textContent=highText;promo.removeAttribute('role');clock.hidden=false;fire.hidden=false;enable();render()}function deactivate(){highEnd=null;remove(highKey);if(!high)return;high=false;delete el.dataset.high;promo.textContent=normalText;promo.removeAttribute('role');clock.hidden=false;fire.hidden=true;enable();render()}async function cart(){if(busy||threshold<=0||document.hidden)return;busy=true;try{const root=window.Shopify?.routes?.root||'/',res=await fetch(root+'cart.js',{headers:{Accept:'application/json'},credentials:'same-origin',cache:'no-store'});if(res.ok){const data=await res.json(),subtotal=Number(data.items_subtotal_price??data.total_price??0);subtotal>=threshold?activate():deactivate()}}catch(_){}finally{busy=false}}render();setInterval(render,250);cart();setInterval(cart,3000);['cart:updated','cart:refresh','product:added'].forEach(n=>document.addEventListener(n,cart));addEventListener('focus',cart);addEventListener('pageshow',cart);document.addEventListener('visibilitychange',()=>{if(!document.hidden)cart()});document.addEventListener('submit',e=>{if(e.target.closest('form[action*="/cart"]'))setTimeout(cart,500)});addEventListener('storage',e=>{const v=Number(e.newValue);if(!Number.isFinite(v)||v<=0)return;if(e.key===baseKey)baseEnd=v;if(e.key===highKey)highEnd=v;if(e.key===baseKey||e.key===highKey)render()})})();
</script>
{% schema %}
{"name":"Sales countdown timer bar","target":"body","settings":[{"type":"number","id":"countdown_minutes","label":"Countdown length in minutes","default":15},{"type":"number","id":"restart_number","label":"Restart timer number","info":"Increase and save to restart every visitor's timer.","default":1},{"type":"number","id":"high_value_threshold","label":"High-value cart threshold","info":"Subtotal that activates the five-minute warning. Set 0 to disable.","default":100},{"type":"text","id":"high_value_text","label":"High-value warning text","default":"Your high-value cart reservations expire in"},{"type":"text","id":"promo_text","label":"Promo text string","default":"HURRY! Flash Sale Ends In:"},{"type":"text","id":"expired_text","label":"Expired text string","default":"Offer expired!"},{"type":"select","id":"positioning","label":"Positioning","default":"top","options":[{"value":"top","label":"Top"},{"value":"bottom","label":"Bottom"}]},{"type":"select","id":"expiry_action","label":"On Expiry Action","default":"message","options":[{"value":"hide","label":"Hide Bar"},{"value":"message","label":"Show Expiry Message"}]},{"type":"url","id":"button_link","label":"Button link URL"},{"type":"text","id":"button_text","label":"Button text label","default":"Shop sale"},{"type":"color","id":"background_color","label":"Background color","default":"#FFF3CD"},{"type":"color","id":"font_color","label":"Font text color","default":"#202223"},{"type":"color","id":"digit_accent","label":"Timer digit accent","default":"#D72C0D"}]}
{% endschema %}
