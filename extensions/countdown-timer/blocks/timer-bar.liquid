<style>
  .zoro-timer-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #202223;
    color: #ffffff;
    box-shadow: 0px -4px 12px rgba(0, 0, 0, 0.15);
    padding: 12px 24px;
    z-index: 2147483647;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: none;
    align-items: center;
    justify-content: space-between;
  }
  .zoro-timer-bar.is-visible { display: flex; }
  .zoro-timer-row { display: flex; align-items: center; gap: 16px; margin: 0 auto; max-width: 1200px; width: 100%; justify-content: space-between; }
  .zoro-timer-clock { font-weight: 700; font-size: 18px; background: #333; padding: 4px 12px; border-radius: 4px; letter-spacing: 1px; color: #ffea00; }
  .zoro-timer-btn { background: #008060; color: white; border: none; padding: 8px 16px; border-radius: 4px; font-weight: 600; cursor: pointer; }
</style>

{% if template contains 'product' %}
  <div class="zoro-timer-bar" id="ZoroCountdownTimerBar">
    <div class="zoro-timer-row">
      <div>⚡ HURRY! Flash Sale Ends In: <span class="zoro-timer-clock" id="ZoroClockDisplay">00:00</span></div>
      <button class="zoro-timer-btn">Claim Discount Now</button>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const timerBar = document.getElementById("ZoroCountdownTimerBar");
      const clockDisplay = document.getElementById("ZoroClockDisplay");

      // Fixed evergreen 15-minute countdown clock logic via LocalStorage
      let duration = 15 * 60;
      let endTime = localStorage.getItem("zoro_timer_end");

      if (!endTime) {
        endTime = Date.now() + (duration * 1000);
        localStorage.setItem("zoro_timer_end", endTime);
      }

      function updateClock() {
        let remaining = Math.round((endTime - Date.now()) / 1000);

        if (remaining <= 0) {
          timerBar.style.display = "none";
          localStorage.removeItem("zoro_timer_end");
          return;
        }

        let minutes = Math.floor(remaining / 60);
        let seconds = remaining % 60;
        clockDisplay.textContent =
          (minutes < 10 ? "0" : "") + minutes + ":" + (seconds < 10 ? "0" : "") + seconds;
      }

      window.addEventListener("scroll", function() {
        if (window.scrollY > 300) { timerBar.classList.add("is-visible"); }
        else { timerBar.classList.remove("is-visible"); }
      });

      setInterval(updateClock, 1000);
      updateClock();
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Zoro Countdown Timer",
  "target": "body",
  "settings": []
}
{% endschema %}
