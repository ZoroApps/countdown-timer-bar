{{ 'timer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'timer.js' | asset_url }}" defer></script>

{% liquid
  assign timer_id = 'countdown-timer-' | append: block.id
  assign position_class = 'countdown-timer--' | append: block.settings.position
%}

<div
  id="{{ timer_id }}"
  class="countdown-timer {{ position_class }}"
  data-countdown-timer
  data-duration-minutes="{{ block.settings.duration_minutes }}"
  data-expiry-action="{{ block.settings.expiry_action }}"
  data-expired-text="{{ block.settings.expired_text | escape }}"
  role="region"
  aria-label="Sales countdown timer"
  style="--p-color-bg-surface: {{ block.settings.background_color }}; --p-color-text: {{ block.settings.text_color }}; --p-color-bg-fill-brand: {{ block.settings.accent_color }};"
  {{ block.shopify_attributes }}
>
  <div class="countdown-timer__layout">
    <p class="countdown-timer__message" data-timer-message>{{ block.settings.promo_text }}</p>

    <div
      class="countdown-timer__clock"
      data-timer-clock
      role="timer"
      aria-live="off"
      aria-label="Time remaining"
    >
      <span class="countdown-timer__digit">
        <strong data-hours>00</strong>
        <small>Hours</small>
      </span>
      <span class="countdown-timer__separator" aria-hidden="true">:</span>
      <span class="countdown-timer__digit">
        <strong data-minutes>00</strong>
        <small>Minutes</small>
      </span>
      <span class="countdown-timer__separator" aria-hidden="true">:</span>
      <span class="countdown-timer__digit">
        <strong data-seconds>00</strong>
        <small>Seconds</small>
      </span>
    </div>

    {% if block.settings.button_text != blank %}
      <a
        class="countdown-timer__button"
        data-timer-button
        href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Sales countdown timer bar",
  "target": "body",
  "settings": [
    {
      "type": "number",
      "id": "duration_minutes",
      "label": "Countdown length in minutes",
      "default": 15
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo text",
      "default": "⚡ HURRY! Flash Sale Ends In:"
    },
    {
      "type": "text",
      "id": "expired_text",
      "label": "Expired text",
      "default": "Offer expired!"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "expiry_action",
      "label": "On expiry",
      "default": "message",
      "options": [
        { "value": "hide", "label": "Hide bar" },
        { "value": "message", "label": "Show expired alert" }
      ]
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop sale"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFF3CD"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#202223"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Timer accent color",
      "default": "#D72C0D"
    }
  ]
}
{% endschema %}
