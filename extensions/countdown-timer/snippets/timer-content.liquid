{% liquid
  assign timer_id = 'zoro-countdown-embed-' | append: block.id
  assign position_class = 'zoro-timer--' | append: block.settings.positioning
  assign preset_class = 'zoro-timer--' | append: block.settings.design_preset
  assign product_collection_handles = product.collections | map: 'handle'
  assign timer_background = block.settings.background_color
  assign timer_text = block.settings.font_color
  assign timer_accent = block.settings.digit_accent

  if timer_background == '#FFF3CD' or timer_background == '#fff3cd'
    assign timer_background = '#050505'
  endif

  if timer_text == '#202223'
    assign timer_text = '#FFFFFF'
  endif

  if timer_accent == '#D72C0D' or timer_accent == '#d72c0d'
    assign timer_accent = '#FFFFFF'
  endif
%}

<div
  id="{{ timer_id }}"
  class="zoro-timer zoro-timer--embed {{ position_class }} {{ preset_class }}"
  role="region"
  aria-label="Sales countdown timer"
  hidden
  {{ block.shopify_attributes }}
>
  <div class="zoro-timer__layout">
    <p class="zoro-timer__promo" data-zoro-promo>{{ block.settings.promo_text }}</p>
    <div class="zoro-timer__clock" data-zoro-clock role="timer" aria-label="Time remaining">
      <span class="zoro-timer__unit" data-zoro-days-unit>
        <span class="zoro-timer__digit"><strong data-zoro-days>00</strong></span>
        {% if block.settings.show_labels %}<small>{{ block.settings.days_label }}</small>{% endif %}
      </span>
      <span class="zoro-timer__separator" data-zoro-days-separator aria-hidden="true">:</span>
      <span class="zoro-timer__unit">
        <span class="zoro-timer__digit"><strong data-zoro-hours>00</strong></span>
        {% if block.settings.show_labels %}<small>{{ block.settings.hours_label }}</small>{% endif %}
      </span>
      <span class="zoro-timer__separator" aria-hidden="true">:</span>
      <span class="zoro-timer__unit">
        <span class="zoro-timer__digit"><strong data-zoro-minutes>00</strong></span>
        {% if block.settings.show_labels %}<small>{{ block.settings.minutes_label }}</small>{% endif %}
      </span>
      <span class="zoro-timer__separator" aria-hidden="true">:</span>
      <span class="zoro-timer__unit">
        <span class="zoro-timer__digit"><strong data-zoro-seconds>00</strong></span>
        {% if block.settings.show_labels %}<small>{{ block.settings.seconds_label }}</small>{% endif %}
      </span>
    </div>
    {% if block.settings.button_text != blank %}
      <a
        class="zoro-timer__button"
        data-zoro-button
        href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
    {% if block.settings.dismissible %}
      <button class="zoro-timer__close" data-zoro-close type="button" aria-label="Close countdown">&times;</button>
    {% endif %}
  </div>
</div>

<style>
  #{{ timer_id }} {
    --zoro-bg: {{ timer_background }};
    --zoro-text: {{ timer_text }};
    --zoro-accent: {{ timer_accent }};
    --zoro-muted: color-mix(in srgb, var(--zoro-text), transparent 28%);
    --zoro-line: color-mix(in srgb, var(--zoro-text), transparent 84%);
    --zoro-raised: color-mix(in srgb, var(--zoro-bg), var(--zoro-text) 7%);
    position: fixed;
    right: 0;
    left: 0;
    z-index: 2147483647;
    box-sizing: border-box;
    width: 100%;
    padding: 8px 18px;
    color: var(--zoro-text);
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.08), transparent 18%, transparent 82%, rgba(255, 255, 255, 0.08)),
      var(--zoro-bg);
    border-block: 1px solid var(--zoro-line);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.2);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    transition: opacity 220ms ease, visibility 220ms ease, transform 220ms ease;
  }

  #{{ timer_id }}[hidden] { display: none !important; }
  #{{ timer_id }} *, #{{ timer_id }} *::before, #{{ timer_id }} *::after { box-sizing: border-box; }
  #{{ timer_id }}.zoro-timer--top { top: 0; }
  #{{ timer_id }}.zoro-timer--bottom { bottom: 0; }
  #{{ timer_id }}.zoro-timer--hidden { visibility: hidden; opacity: 0; pointer-events: none; }
  #{{ timer_id }}.zoro-timer--top.zoro-timer--hidden { transform: translateY(-100%); }
  #{{ timer_id }}.zoro-timer--bottom.zoro-timer--hidden { transform: translateY(100%); }

  #{{ timer_id }} .zoro-timer__layout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
  }

  #{{ timer_id }} .zoro-timer__promo {
    margin: 0;
    overflow: hidden;
    color: var(--zoro-text);
    font-size: clamp(0.68rem, 0.84vw, 0.8rem);
    font-weight: 750;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #{{ timer_id }} .zoro-timer__promo::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 9px;
    background: var(--zoro-accent);
    border-radius: 999px;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--zoro-accent), transparent 84%);
    vertical-align: 1px;
  }

  #{{ timer_id }} .zoro-timer__clock {
    display: flex;
    flex-shrink: 0;
    align-items: stretch;
    gap: 5px;
    padding: 3px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--zoro-line);
    border-radius: 999px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  #{{ timer_id }} .zoro-timer__unit { display: grid; justify-items: center; gap: 2px; }
  #{{ timer_id }} .zoro-timer__unit small {
    color: var(--zoro-muted);
    font-size: 0.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #{{ timer_id }} .zoro-timer__digit {
    display: grid;
    min-width: 34px;
    min-height: 30px;
    place-content: center;
    padding: 4px 8px;
    color: var(--zoro-bg);
    background: var(--zoro-accent);
    border: 1px solid color-mix(in srgb, var(--zoro-accent), #000000 10%);
    border-radius: 999px;
    box-shadow:
      inset 0 -1px 0 rgba(0, 0, 0, 0.12),
      0 6px 18px rgba(0, 0, 0, 0.18);
  }

  #{{ timer_id }} .zoro-timer__digit strong {
    font-size: clamp(0.74rem, 1vw, 0.88rem);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    line-height: 0.95;
  }

  #{{ timer_id }} .zoro-timer__separator {
    align-self: center;
    color: var(--zoro-muted);
    font-size: 0.76rem;
    font-weight: 800;
  }

  #{{ timer_id }} .zoro-timer__button {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 6px 14px;
    color: var(--zoro-bg);
    background: var(--zoro-accent);
    border: 1px solid color-mix(in srgb, var(--zoro-accent), #000000 10%);
    border-radius: 999px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.22);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: transform 160ms ease, filter 160ms ease;
  }

  #{{ timer_id }} .zoro-timer__button:hover { filter: brightness(0.92); transform: translateY(-1px); }
  #{{ timer_id }} .zoro-timer__button[aria-disabled='true'] { opacity: 0.5; pointer-events: none; }
  #{{ timer_id }} .zoro-timer__close {
    display: grid;
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    place-content: center;
    padding: 0;
    color: var(--zoro-text);
    background: transparent;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 1rem;
    cursor: pointer;
    opacity: 0.72;
  }

  #{{ timer_id }} .zoro-timer__close:hover { background: rgba(0, 0, 0, 0.08); opacity: 1; }
  #{{ timer_id }}.zoro-timer--minimal { box-shadow: none; }
  #{{ timer_id }}.zoro-timer--minimal .zoro-timer__digit {
    min-width: 30px;
    color: var(--zoro-accent);
    background: transparent;
    border-color: var(--zoro-line);
    box-shadow: none;
  }

  #{{ timer_id }}.zoro-timer--urgent {
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.1), transparent 18%, rgba(255, 255, 255, 0.08), transparent 82%, rgba(255, 255, 255, 0.1)),
      var(--zoro-bg);
    background-size: 200% 100%;
    animation: zoroUrgencyShift 2.4s ease-in-out infinite;
  }

  @keyframes zoroUrgencyShift {
    0%, 100% { background-position: 0 50%; }
    50% { background-position: 100% 50%; }
  }

  @media screen and (max-width: 749px) {
    #{{ timer_id }} { padding: 7px 8px; }
    #{{ timer_id }} .zoro-timer__layout { gap: 7px; }
    #{{ timer_id }} .zoro-timer__promo { flex: 1 1 auto; font-size: clamp(0.58rem, 2.3vw, 0.68rem); letter-spacing: 0.08em; }
    #{{ timer_id }} .zoro-timer__promo::before { width: 5px; height: 5px; margin-right: 6px; }
    #{{ timer_id }} .zoro-timer__clock { gap: 3px; padding: 2px; }
    #{{ timer_id }} .zoro-timer__digit { min-width: 28px; min-height: 26px; padding: 3px 5px; }
    #{{ timer_id }} .zoro-timer__digit strong { font-size: 0.68rem; }
    #{{ timer_id }} .zoro-timer__separator { font-size: 0.62rem; }
    #{{ timer_id }} .zoro-timer__button { min-height: 28px; padding: 4px 8px; font-size: 0.56rem; letter-spacing: 0.06em; }
    #{{ timer_id }} .zoro-timer__close { flex-basis: 22px; width: 22px; height: 22px; }
  }

  @media screen and (max-width: 480px) {
    #{{ timer_id }} .zoro-timer__button { display: none; }
    #{{ timer_id }} .zoro-timer__unit small { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ timer_id }}, #{{ timer_id }}.zoro-timer--urgent { transition: none; animation: none; }
  }
</style>

<script>
  (() => {
    const timerId = {{ timer_id | json }};
    const container = document.getElementById(timerId);
    if (!container || container.dataset.zoroInitialized === 'true') return;
    container.dataset.zoroInitialized = 'true';

    const config = {
      mode: {{ block.settings.timer_mode | json }},
      days: Math.max(0, Math.min(30, Number({{ block.settings.countdown_days | json }}) || 0)),
      hours: Math.max(0, Math.min(23, Number({{ block.settings.countdown_hours | json }}) || 0)),
      minutes: Math.max(0, Math.min(59, Number({{ block.settings.countdown_minutes | json }}) || 0)),
      clockDisplay: {{ block.settings.clock_display | default: 'auto' | json }},
      fixedEnd: {{ block.settings.fixed_end | json }},
      dailyHour: Math.max(0, Math.min(23, Number({{ block.settings.daily_end_hour | json }}) || 0)),
      dailyMinute: Math.max(0, Math.min(59, Number({{ block.settings.daily_end_minute | json }}) || 0)),
      resetToken: String({{ block.settings.reset_token | json }}),
      pageVisibility: {{ block.settings.page_visibility | json }},
      deviceVisibility: {{ block.settings.device_visibility | json }},
      catalogTargetingEnabled: {{ block.settings.catalog_targeting_enabled | json }},
      includeProductHandles: {{ block.settings.include_product_handles | json }},
      includeVendors: {{ block.settings.include_vendors | json }},
      includeProductTypes: {{ block.settings.include_product_types | json }},
      includeProductTags: {{ block.settings.include_product_tags | json }},
      includeCollections: {{ block.settings.include_collections | json }},
      excludeProductHandles: {{ block.settings.exclude_product_handles | json }},
      excludeVendors: {{ block.settings.exclude_vendors | json }},
      expiryAction: {{ block.settings.expiry_action | json }},
      expiredText: {{ block.settings.expired_text | json }},
      pageType: {{ request.page_type | json }},
      product: {
        handle: {{ product.handle | default: '' | json }},
        vendor: {{ product.vendor | default: '' | json }},
        type: {{ product.type | default: '' | json }},
        tags: {{ product.tags | json }},
        collections: {{ product_collection_handles | json }}
      },
      collectionHandle: {{ collection.handle | default: '' | json }}
    };
    const sessionKey = 'zoro_timer_session_v4';
    const dismissedKey = 'zoro_timer_dismissed_v1';
    const promo = container.querySelector('[data-zoro-promo]');
    const clock = container.querySelector('[data-zoro-clock]');
    const button = container.querySelector('[data-zoro-button]');
    const closeButton = container.querySelector('[data-zoro-close]');
    const dayUnit = container.querySelector('[data-zoro-days-unit]');
    const daySeparator = container.querySelector('[data-zoro-days-separator]');
    const days = container.querySelector('[data-zoro-days]');
    const hours = container.querySelector('[data-zoro-hours]');
    const minutes = container.querySelector('[data-zoro-minutes]');
    const seconds = container.querySelector('[data-zoro-seconds]');
    const originalPromo = promo.textContent;
    const originalButtonHref = button?.getAttribute('href') || '';
    let intervalId = null;
    let cartPollId = null;
    let endTime = 0;
    let expired = false;

    const readJson = (key) => {
      try { return JSON.parse(localStorage.getItem(key)); }
      catch (error) { return null; }
    };

    const writeJson = (key, value) => {
      try { localStorage.setItem(key, JSON.stringify(value)); }
      catch (error) { /* Continue in memory when storage is unavailable. */ }
    };

    const removeStored = (key) => {
      try { localStorage.removeItem(key); }
      catch (error) { /* Nothing to remove. */ }
    };

    const isTargetPage = () => {
      if (config.pageVisibility === 'all') return true;
      if (config.pageVisibility === 'home') return config.pageType === 'index';
      return config.pageType === config.pageVisibility;
    };

    const isTargetDevice = () => {
      if (config.deviceVisibility === 'all') return true;
      const mobile = matchMedia('(max-width: 749px)').matches;
      return config.deviceVisibility === (mobile ? 'mobile' : 'desktop');
    };

    const parseRules = (value) => String(value || '')
      .split(',')
      .map((item) => item.trim().toLowerCase())
      .filter(Boolean);

    const includesValue = (rules, value) => Boolean(
      value && rules.includes(String(value).trim().toLowerCase())
    );

    const includesAny = (rules, values) => {
      const normalized = Array.isArray(values)
        ? values.map((value) => String(value).trim().toLowerCase())
        : [];
      return rules.some((rule) => normalized.includes(rule));
    };

    const isTargetCatalog = () => {
      const includeHandles = parseRules(config.includeProductHandles);
      const includeVendors = parseRules(config.includeVendors);
      const includeTypes = parseRules(config.includeProductTypes);
      const includeTags = parseRules(config.includeProductTags);
      const includeCollections = parseRules(config.includeCollections);
      const excludeHandles = parseRules(config.excludeProductHandles);
      const excludeVendors = parseRules(config.excludeVendors);

      if (
        includesValue(excludeHandles, config.product.handle) ||
        includesValue(excludeVendors, config.product.vendor)
      ) {
        return false;
      }

      if (!config.catalogTargetingEnabled) return true;

      const hasInclusionRules = [
        includeHandles,
        includeVendors,
        includeTypes,
        includeTags,
        includeCollections
      ].some((rules) => rules.length > 0);

      if (!hasInclusionRules) return false;

      return (
        includesValue(includeHandles, config.product.handle) ||
        includesValue(includeVendors, config.product.vendor) ||
        includesValue(includeTypes, config.product.type) ||
        includesAny(includeTags, config.product.tags) ||
        includesValue(includeCollections, config.collectionHandle) ||
        includesAny(includeCollections, config.product.collections)
      );
    };

    const durationMs = Math.max(
      60000,
      ((config.days * 1440) + (config.hours * 60) + config.minutes) * 60000
    );
    const signature = [
      config.mode,
      config.days,
      config.hours,
      config.minutes,
      config.clockDisplay,
      config.fixedEnd,
      config.dailyHour,
      config.dailyMinute,
      config.resetToken
    ].join('|');

    const getFixedEnd = () => {
      const parsed = Date.parse(config.fixedEnd);
      return Number.isFinite(parsed) ? parsed : 0;
    };

    const getDailyEnd = () => {
      const now = new Date();
      const target = new Date(now);
      target.setHours(config.dailyHour, config.dailyMinute, 0, 0);
      if (target.getTime() <= now.getTime()) target.setDate(target.getDate() + 1);
      return target.getTime();
    };

    const getEvergreenEnd = () => {
      const session = readJson(sessionKey);
      if (
        session &&
        session.signature === signature &&
        Number.isFinite(Number(session.endTime)) &&
        Number(session.endTime) > Date.now()
      ) {
        return Number(session.endTime);
      }
      const nextEnd = Date.now() + durationMs;
      writeJson(sessionKey, { signature, endTime: nextEnd });
      return nextEnd;
    };

    const getCart = async () => {
      try {
        const response = await fetch('/cart.js', {
          credentials: 'same-origin',
          headers: { Accept: 'application/json' }
        });
        if (!response.ok) return null;
        return await response.json();
      } catch (error) {
        return null;
      }
    };

    const setCartState = async () => {
      const cart = await getCart();
      if (!cart) return;
      if (Number(cart.item_count) <= 0) {
        removeStored(sessionKey);
        if (intervalId !== null) clearInterval(intervalId);
        intervalId = null;
        endTime = 0;
        expired = false;
        promo.textContent = originalPromo;
        clock.hidden = false;
        container.classList.remove('zoro-timer--hidden');
        if (button && originalButtonHref) {
          button.setAttribute('href', originalButtonHref);
          button.removeAttribute('aria-disabled');
          button.removeAttribute('tabindex');
        }
        container.hidden = true;
        return;
      }
      container.hidden = false;
      if (!endTime && !expired) {
        endTime = getEvergreenEnd();
      }
      ensureTicker();
    };

    const pad = (value) => String(value).padStart(2, '0');

    const shouldShowDays = (totalSeconds) => {
      if (config.clockDisplay === 'days') return true;
      if (config.clockDisplay === 'hours') return false;
      return totalSeconds >= 86400;
    };

    const expire = () => {
      if (expired) return;
      expired = true;
      if (intervalId !== null) clearInterval(intervalId);
      intervalId = null;
      days.textContent = hours.textContent = minutes.textContent = seconds.textContent = '00';
      if (button) {
        button.removeAttribute('href');
        button.setAttribute('aria-disabled', 'true');
        button.setAttribute('tabindex', '-1');
      }
      if (config.expiryAction === 'hide') container.classList.add('zoro-timer--hidden');
      else {
        promo.textContent = config.expiredText;
        promo.setAttribute('role', 'alert');
        clock.hidden = true;
      }
    };

    const render = () => {
      if (!endTime) return;
      const remainingMs = Math.max(0, endTime - Date.now());
      const totalSeconds = Math.ceil(remainingMs / 1000);
      const displayDays = shouldShowDays(totalSeconds);
      const displayHours = displayDays
        ? Math.floor((totalSeconds % 86400) / 3600)
        : Math.floor(totalSeconds / 3600);

      days.textContent = pad(Math.floor(totalSeconds / 86400));
      hours.textContent = pad(displayHours);
      minutes.textContent = pad(Math.floor((totalSeconds % 3600) / 60));
      seconds.textContent = pad(totalSeconds % 60);
      dayUnit.hidden = !displayDays;
      daySeparator.hidden = !displayDays;
      if (remainingMs <= 0) {
        if (config.mode === 'daily') {
          endTime = getDailyEnd();
          return;
        }
        expire();
      }
    };

    const ensureTicker = () => {
      if (!endTime || endTime <= Date.now() || expired || intervalId !== null) return;
      render();
      intervalId = setInterval(render, 250);
    };

    const initialize = async () => {
      if (!isTargetPage() || !isTargetDevice() || !isTargetCatalog()) return;
      const dismissed = readJson(dismissedKey);
      if (dismissed && dismissed.signature === signature) return;

      if (config.mode === 'fixed') endTime = getFixedEnd();
      else if (config.mode === 'daily') endTime = getDailyEnd();
      else endTime = getEvergreenEnd();

      if (config.mode === 'cart') {
        await setCartState();
        cartPollId = setInterval(setCartState, 3000);
        document.addEventListener('cart:refresh', setCartState);
        document.addEventListener('cart:updated', setCartState);
        return;
      }

      container.hidden = false;
      if (!endTime || endTime <= Date.now()) expire();
      else ensureTicker();
    };

    if (closeButton) {
      closeButton.addEventListener('click', () => {
        writeJson(dismissedKey, { signature, dismissedAt: Date.now() });
        container.classList.add('zoro-timer--hidden');
      });
    }

    addEventListener('storage', (event) => {
      if (event.key === sessionKey && ['evergreen', 'cart'].includes(config.mode)) {
        endTime = getEvergreenEnd();
        render();
      }
      if (event.key === dismissedKey && readJson(dismissedKey)?.signature === signature) {
        container.classList.add('zoro-timer--hidden');
      }
    });

    addEventListener('resize', () => {
      if (config.mode !== 'cart') {
        container.hidden = !(isTargetPage() && isTargetDevice() && isTargetCatalog());
      }
    });

    addEventListener('pagehide', () => {
      if (intervalId !== null) clearInterval(intervalId);
      if (cartPollId !== null) clearInterval(cartPollId);
    }, { once: true });

    initialize();
  })();
</script>
