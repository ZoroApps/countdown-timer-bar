{% liquid
  assign timer_id = 'zoro-standalone-timer-' | append: block.id
  assign position_class = 'zoro-timer--' | append: block.settings.positioning
%}

<div
  id="{{ timer_id }}"
  class="zoro-timer {{ position_class }}"
  role="region"
  aria-label="Sales countdown timer"
  {{ block.shopify_attributes }}
>
  <div class="zoro-timer__layout">
    <p class="zoro-timer__promo" data-zoro-promo>
      <span aria-hidden="true">⚡</span>
      {{ block.settings.promo_text }}
    </p>

    <div class="zoro-timer__clock" data-zoro-clock role="timer" aria-label="Time remaining">
      <span class="zoro-timer__digit"><strong data-zoro-hours>00</strong><small>Hours</small></span>
      <span class="zoro-timer__separator" aria-hidden="true">:</span>
      <span class="zoro-timer__digit"><strong data-zoro-minutes>00</strong><small>Minutes</small></span>
      <span class="zoro-timer__separator" aria-hidden="true">:</span>
      <span class="zoro-timer__digit"><strong data-zoro-seconds>00</strong><small>Seconds</small></span>
    </div>

    {% if block.settings.button_text != blank %}
      <a
        class="zoro-timer__button"
        data-zoro-button
        href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

<style>
  #{{ timer_id }} {
    --p-color-bg-surface: {{ block.settings.background_color }};
    --p-color-text: {{ block.settings.font_color }};
    --p-color-bg-fill-brand: {{ block.settings.digit_accent }};
    --p-color-text-on-color: #ffffff;
    --p-color-border: rgba(0, 0, 0, 0.16);
    --p-shadow-300: 0 4px 12px rgba(0, 0, 0, 0.16);
    --p-border-radius-200: 8px;
    --p-space-100: 4px;
    --p-space-200: 8px;
    --p-space-300: 12px;
    --p-space-400: 16px;
    --p-space-500: 20px;

    position: fixed;
    right: 0;
    left: 0;
    z-index: 2147483647;
    box-sizing: border-box;
    width: 100%;
    padding: var(--p-space-300) var(--p-space-500);
    color: var(--p-color-text);
    background: var(--p-color-bg-surface);
    box-shadow: var(--p-shadow-300);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    transition: opacity 260ms ease, visibility 260ms ease, transform 260ms ease;
  }

  #{{ timer_id }} *,
  #{{ timer_id }} *::before,
  #{{ timer_id }} *::after { box-sizing: border-box; }

  #{{ timer_id }}.zoro-timer--top { top: 0; }
  #{{ timer_id }}.zoro-timer--bottom { bottom: 0; }

  #{{ timer_id }}.zoro-timer--hidden {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  #{{ timer_id }}.zoro-timer--top.zoro-timer--hidden { transform: translateY(-100%); }
  #{{ timer_id }}.zoro-timer--bottom.zoro-timer--hidden { transform: translateY(100%); }

  #{{ timer_id }} .zoro-timer__layout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--p-space-500);
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  #{{ timer_id }} .zoro-timer__promo {
    margin: 0;
    font-size: clamp(0.92rem, 1.3vw, 1.08rem);
    font-weight: 700;
    line-height: 1.3;
  }

  #{{ timer_id }} .zoro-timer__clock {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--p-space-100);
  }

  #{{ timer_id }} .zoro-timer__digit {
    display: grid;
    min-width: 58px;
    min-height: 54px;
    place-content: center;
    padding: var(--p-space-100) var(--p-space-200);
    color: var(--p-color-text-on-color);
    background: var(--p-color-bg-fill-brand);
    border: 1px solid var(--p-color-border);
    border-radius: var(--p-border-radius-200);
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.16);
    text-align: center;
  }

  #{{ timer_id }} .zoro-timer__digit strong {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  #{{ timer_id }} .zoro-timer__digit small {
    margin-top: var(--p-space-100);
    font-size: 0.56rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #{{ timer_id }} .zoro-timer__separator {
    font-size: 1.35rem;
    font-weight: 700;
  }

  #{{ timer_id }} .zoro-timer__button {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--p-space-200) var(--p-space-400);
    color: var(--p-color-text-on-color);
    background: var(--p-color-bg-fill-brand);
    border: 1px solid var(--p-color-border);
    border-radius: var(--p-border-radius-200);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
    transition: filter 150ms ease, opacity 150ms ease;
  }

  #{{ timer_id }} .zoro-timer__button:hover { filter: brightness(0.92); }
  #{{ timer_id }} .zoro-timer__button:focus-visible { outline: 3px solid var(--p-color-text-on-color); outline-offset: 2px; }
  #{{ timer_id }} .zoro-timer__button[aria-disabled='true'] { opacity: 0.5; pointer-events: none; }

  @media screen and (max-width: 749px) {
    #{{ timer_id }} { padding: clamp(8px, 2.5vw, 12px) clamp(8px, 3vw, 14px); }

    #{{ timer_id }} .zoro-timer__layout {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: var(--p-space-200) var(--p-space-300);
    }

    #{{ timer_id }} .zoro-timer__promo {
      grid-column: 1 / -1;
      font-size: clamp(0.78rem, 3.5vw, 0.92rem);
      text-align: center;
    }

    #{{ timer_id }} .zoro-timer__clock { justify-self: end; }
    #{{ timer_id }} .zoro-timer__digit { min-width: 44px; min-height: 46px; padding: var(--p-space-100); }
    #{{ timer_id }} .zoro-timer__separator { font-size: 1.05rem; }
    #{{ timer_id }} .zoro-timer__button { min-height: 44px; padding: var(--p-space-200) var(--p-space-300); font-size: 0.8rem; }
  }

  @media screen and (max-width: 430px) {
    #{{ timer_id }} .zoro-timer__layout { grid-template-columns: 1fr; }
    #{{ timer_id }} .zoro-timer__clock,
    #{{ timer_id }} .zoro-timer__button { justify-self: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ timer_id }},
    #{{ timer_id }} .zoro-timer__button { transition: none; }
  }
</style>

<script>
  (() => {
    const container = document.getElementById({{ timer_id | json }});
    if (!container || container.dataset.zoroInitialized === 'true') return;
    container.dataset.zoroInitialized = 'true';

    const storageKey = 'zoro_standalone_timer_session';
    const durationMinutes = Math.max(1, Number({{ block.settings.countdown_minutes | json }}) || 15);
    const durationMs = durationMinutes * 60 * 1000;
    const expiryAction = {{ block.settings.expiry_action | json }};
    const expiredText = {{ block.settings.expired_text | json }};
    const promo = container.querySelector('[data-zoro-promo]');
    const clock = container.querySelector('[data-zoro-clock]');
    const button = container.querySelector('[data-zoro-button]');
    const hours = container.querySelector('[data-zoro-hours]');
    const minutes = container.querySelector('[data-zoro-minutes]');
    const seconds = container.querySelector('[data-zoro-seconds]');
    let intervalId = null;
    let expired = false;

    const readSession = () => {
      try {
        const session = JSON.parse(window.localStorage.getItem(storageKey));
        if (!session || !Number.isFinite(Number(session.endTime))) return null;
        return { endTime: Number(session.endTime) };
      } catch (error) {
        return null;
      }
    };

    const writeSession = (endTime) => {
      try {
        window.localStorage.setItem(storageKey, JSON.stringify({ endTime }));
      } catch (error) {
        // The in-memory timestamp keeps the timer functional when storage is blocked.
      }
    };

    let session = readSession();
    let endTime = session ? session.endTime : null;

    if (endTime === null) {
      endTime = Date.now() + durationMs;
      writeSession(endTime);
    }

    const pad = (value) => String(value).padStart(2, '0');

    const disableButton = () => {
      if (!button) return;
      button.removeAttribute('href');
      button.setAttribute('aria-disabled', 'true');
      button.setAttribute('tabindex', '-1');
    };

    const expire = () => {
      if (expired) return;
      expired = true;
      if (intervalId !== null) window.clearInterval(intervalId);
      hours.textContent = '00';
      minutes.textContent = '00';
      seconds.textContent = '00';
      disableButton();

      if (expiryAction === 'hide') {
        container.classList.add('zoro-timer--hidden');
      } else {
        promo.textContent = expiredText;
        promo.setAttribute('role', 'alert');
        clock.hidden = true;
      }
    };

    const render = () => {
      const remainingMs = Math.max(0, endTime - Date.now());
      const totalSeconds = Math.ceil(remainingMs / 1000);
      hours.textContent = pad(Math.floor(totalSeconds / 3600));
      minutes.textContent = pad(Math.floor((totalSeconds % 3600) / 60));
      seconds.textContent = pad(totalSeconds % 60);
      if (remainingMs <= 0) expire();
    };

    render();
    if (!expired) intervalId = window.setInterval(render, 250);

    window.addEventListener('storage', (event) => {
      if (event.key !== storageKey || !event.newValue) return;
      const syncedSession = readSession();
      if (!syncedSession) return;
      endTime = syncedSession.endTime;
      render();
    });
  })();
</script>

{% schema %}
{
  "name": "Sales countdown timer bar",
  "target": "body",
  "settings": [
    { "type": "number", "id": "countdown_minutes", "label": "Countdown length in minutes", "default": 15 },
    { "type": "text", "id": "promo_text", "label": "Promo text string", "default": "HURRY! Flash Sale Ends In:" },
    { "type": "text", "id": "expired_text", "label": "Expired text string", "default": "Offer expired!" },
    {
      "type": "select",
      "id": "positioning",
      "label": "Positioning",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "expiry_action",
      "label": "On Expiry Action",
      "default": "message",
      "options": [
        { "value": "hide", "label": "Hide Bar" },
        { "value": "message", "label": "Show Expiry Message" }
      ]
    },
    { "type": "url", "id": "button_link", "label": "Button link URL" },
    { "type": "text", "id": "button_text", "label": "Button text label", "default": "Shop sale" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FFF3CD" },
    { "type": "color", "id": "font_color", "label": "Font text color", "default": "#202223" },
    { "type": "color", "id": "digit_accent", "label": "Timer digit accent", "default": "#D72C0D" }
  ]
}
{% endschema %}
