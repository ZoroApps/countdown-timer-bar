{% liquid
  assign timer_id = 'zoro-timer-' | append: block.id
  assign position_class = 'zoro-timer--' | append: block.settings.bar_position
%}

<div
  id="{{ timer_id }}"
  class="zoro-timer {{ position_class }}"
  role="region"
  aria-label="Sales countdown timer"
  {{ block.shopify_attributes }}
>
  <div class="zoro-timer__content">
    <p class="zoro-timer__message" data-zoro-message>{{ block.settings.banner_copy }}</p>

    <div class="zoro-timer__clock" data-zoro-clock role="timer" aria-live="off" aria-label="Time remaining">
      <span class="zoro-timer__unit">
        <strong data-zoro-hours>00</strong>
        <small>Hours</small>
      </span>
      <span class="zoro-timer__separator" aria-hidden="true">:</span>
      <span class="zoro-timer__unit">
        <strong data-zoro-minutes>00</strong>
        <small>Minutes</small>
      </span>
      <span class="zoro-timer__separator" aria-hidden="true">:</span>
      <span class="zoro-timer__unit">
        <strong data-zoro-seconds>00</strong>
        <small>Seconds</small>
      </span>
    </div>

    {% if block.settings.promo_badge != blank %}
      <span class="zoro-timer__badge">{{ block.settings.promo_badge }}</span>
    {% endif %}

    {% if block.settings.button_label != blank %}
      <a
        class="zoro-timer__button"
        href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
      >
        {{ block.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

<style>
  #{{ timer_id }} {
    --zoro-bar-background: {{ block.settings.bar_background }};
    --zoro-text-color: {{ block.settings.text_color }};
    --zoro-accent-color: {{ block.settings.timer_accent }};
    --zoro-surface-color: #ffffff;
    --zoro-shadow-color: rgba(0, 0, 0, 0.18);
    --zoro-radius: 8px;
    --zoro-space-100: 4px;
    --zoro-space-200: 8px;
    --zoro-space-300: 12px;
    --zoro-space-400: 16px;
    --zoro-space-500: 20px;

    position: fixed;
    right: 0;
    left: 0;
    z-index: 2147483000;
    box-sizing: border-box;
    width: 100%;
    padding: var(--zoro-space-300) var(--zoro-space-400);
    color: var(--zoro-text-color);
    background: var(--zoro-bar-background);
    box-shadow: 0 2px 8px var(--zoro-shadow-color);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    transition: opacity 240ms ease, visibility 240ms ease, transform 240ms ease;
  }

  #{{ timer_id }}.zoro-timer--top {
    top: 0;
  }

  #{{ timer_id }}.zoro-timer--bottom {
    bottom: 0;
  }

  #{{ timer_id }}.zoro-timer--hidden {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  #{{ timer_id }}.zoro-timer--top.zoro-timer--hidden {
    transform: translateY(-100%);
  }

  #{{ timer_id }}.zoro-timer--bottom.zoro-timer--hidden {
    transform: translateY(100%);
  }

  #{{ timer_id }} .zoro-timer__content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--zoro-space-400);
    max-width: 1200px;
    margin: 0 auto;
  }

  #{{ timer_id }} .zoro-timer__message {
    margin: 0;
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
    font-weight: 650;
    line-height: 1.3;
  }

  #{{ timer_id }} .zoro-timer__clock {
    display: flex;
    align-items: center;
    gap: var(--zoro-space-100);
    flex-shrink: 0;
  }

  #{{ timer_id }} .zoro-timer__unit {
    display: grid;
    min-width: 56px;
    min-height: 52px;
    place-content: center;
    padding: var(--zoro-space-100) var(--zoro-space-200);
    color: var(--zoro-surface-color);
    background: var(--zoro-accent-color);
    border-radius: var(--zoro-radius);
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.14);
    text-align: center;
  }

  #{{ timer_id }} .zoro-timer__unit strong {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  #{{ timer_id }} .zoro-timer__unit small {
    margin-top: 3px;
    font-size: 0.58rem;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
  }

  #{{ timer_id }} .zoro-timer__separator {
    color: var(--zoro-accent-color);
    font-size: 1.35rem;
    font-weight: 700;
  }

  #{{ timer_id }} .zoro-timer__badge {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: var(--zoro-space-100) var(--zoro-space-300);
    color: var(--zoro-accent-color);
    background: var(--zoro-surface-color);
    border: 1px solid color-mix(in srgb, var(--zoro-accent-color) 25%, transparent);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  #{{ timer_id }} .zoro-timer__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: var(--zoro-space-200) var(--zoro-space-400);
    color: var(--zoro-surface-color);
    background: var(--zoro-accent-color);
    border: 1px solid transparent;
    border-radius: var(--zoro-radius);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.18);
    font-size: 0.88rem;
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: filter 150ms ease, transform 150ms ease;
  }

  #{{ timer_id }} .zoro-timer__button:hover {
    filter: brightness(0.92);
  }

  #{{ timer_id }} .zoro-timer__button:active {
    transform: translateY(1px);
  }

  #{{ timer_id }} .zoro-timer__button:focus-visible {
    outline: 3px solid var(--zoro-surface-color);
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    #{{ timer_id }} {
      padding: var(--zoro-space-300);
    }

    #{{ timer_id }} .zoro-timer__content {
      flex-wrap: wrap;
      gap: var(--zoro-space-200) var(--zoro-space-300);
    }

    #{{ timer_id }} .zoro-timer__message {
      flex-basis: 100%;
      text-align: center;
    }

    #{{ timer_id }} .zoro-timer__unit {
      min-width: 52px;
      min-height: 48px;
    }

    #{{ timer_id }} .zoro-timer__badge {
      min-height: 32px;
    }

    #{{ timer_id }} .zoro-timer__button {
      min-height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ timer_id }},
    #{{ timer_id }} .zoro-timer__button {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const container = document.getElementById({{ timer_id | json }});
    if (!container || container.dataset.zoroInitialized === 'true') return;
    container.dataset.zoroInitialized = 'true';

    const storageKey = 'zoro_timer_session';
    const durationMinutes = Math.max(1, Number({{ block.settings.duration_minutes | json }}) || 15);
    const durationMs = durationMinutes * 60 * 1000;
    const expiryMessage = {{ block.settings.expiry_text | json }};
    const expiryAction = {{ block.settings.expiry_action | json }};
    const message = container.querySelector('[data-zoro-message]');
    const clock = container.querySelector('[data-zoro-clock]');
    const hours = container.querySelector('[data-zoro-hours]');
    const minutes = container.querySelector('[data-zoro-minutes]');
    const seconds = container.querySelector('[data-zoro-seconds]');
    let intervalId;

    const readStoredEndTime = () => {
      try {
        const value = Number(window.localStorage.getItem(storageKey));
        return Number.isFinite(value) && value > 0 ? value : null;
      } catch (error) {
        return null;
      }
    };

    const saveEndTime = (value) => {
      try {
        window.localStorage.setItem(storageKey, String(value));
      } catch (error) {
        // The in-memory end time still keeps the timer stable for this page view.
      }
    };

    let endTime = readStoredEndTime();
    if (endTime === null) {
      endTime = Date.now() + durationMs;
      saveEndTime(endTime);
    }

    const pad = (value) => String(value).padStart(2, '0');

    const expire = () => {
      window.clearInterval(intervalId);
      hours.textContent = '00';
      minutes.textContent = '00';
      seconds.textContent = '00';
      clock.setAttribute('aria-label', 'Offer expired');

      if (expiryAction === 'hide') {
        container.classList.add('zoro-timer--hidden');
      } else {
        message.textContent = expiryMessage;
        clock.hidden = true;
      }
    };

    const render = () => {
      const remainingMs = Math.max(0, endTime - Date.now());
      const totalSeconds = Math.floor(remainingMs / 1000);

      hours.textContent = pad(Math.floor(totalSeconds / 3600));
      minutes.textContent = pad(Math.floor((totalSeconds % 3600) / 60));
      seconds.textContent = pad(totalSeconds % 60);

      if (remainingMs <= 0) expire();
    };

    render();
    if (endTime > Date.now()) intervalId = window.setInterval(render, 250);
  })();
</script>

{% schema %}
{
  "name": "Sales countdown timer bar",
  "target": "body",
  "settings": [
    {
      "type": "number",
      "id": "duration_minutes",
      "label": "Timer duration in minutes",
      "default": 15
    },
    {
      "type": "text",
      "id": "banner_copy",
      "label": "Text banner copy",
      "default": "⚡ HURRY! Flash Sale Ends In:"
    },
    {
      "type": "text",
      "id": "expiry_text",
      "label": "Expiry banner text",
      "default": "Offer has expired!"
    },
    {
      "type": "select",
      "id": "expiry_action",
      "label": "When timer expires",
      "default": "message",
      "options": [
        {
          "value": "message",
          "label": "Show expiry message"
        },
        {
          "value": "hide",
          "label": "Fade out and hide bar"
        }
      ]
    },
    {
      "type": "select",
      "id": "bar_position",
      "label": "Bar position",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "text",
      "id": "promo_badge",
      "label": "Promo callout badge",
      "default": "Limited time"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop sale"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "bar_background",
      "label": "Bar background color",
      "default": "#FFF3CD"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text font color",
      "default": "#202223"
    },
    {
      "type": "color",
      "id": "timer_accent",
      "label": "Timer accent color",
      "default": "#D72C0D"
    }
  ]
}
{% endschema %}
